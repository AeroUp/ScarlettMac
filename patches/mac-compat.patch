+/// A run of the public BC6H layout: `len` bits of channel `ch` (0-2; 3 is
+/// the partition) of endpoint `ep`, from bit `first` up.
+#[derive(Clone, Copy)]
+struct Run {
+    ch: u8,
+    ep: u8,
+    first: u8,
+    len: u8,
