+// BC6H.
+
+/// Bits of endpoint 0, then of the other endpoints' R, G, B, per mode 1-14.
+const BC6_BITS: [[u8; 4]; 15] = [
+    [0; 4],
+    [10, 5, 5, 5],
+    [7, 6, 6, 6],
+    [11, 5, 4, 4],
+    [11, 4, 5, 4],
+    [11, 4, 4, 5],
+    [9, 5, 5, 5],
+    [8, 6, 5, 5],
+    [8, 5, 6, 5],
+    [8, 5, 5, 6],
+    [6, 6, 6, 6],
+    [10, 10, 10, 10],
+    [11, 9, 9, 9],
+    [12, 8, 8, 8],
+    [16, 4, 4, 4],
+];
+/// Mode code and its width, modes 1-14.
+const BC6_CODE: [(u64, u32); 15] = [
+    (0, 0),
+    (0, 2),
+    (1, 2),
+    (2, 5),
+    (6, 5),
+    (10, 5),
+    (14, 5),
+    (18, 5),
+    (22, 5),
+    (26, 5),
+    (30, 5),
+    (3, 5),
+    (7, 5),
+    (11, 5),
+    (15, 5),
+];
