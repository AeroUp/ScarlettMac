diff --git a/crates/xcl/tests/bcpack_parity.rs b/crates/xcl/tests/bcpack_parity.rs
new file mode 100644
index 0000000000000000000000000000000000000000..06aad8e3d9b43deaa436d5a7dfd761142d62fd28
--- /dev/null
+++ b/crates/xcl/tests/bcpack_parity.rs
@@ -0,0 +1,50 @@
+//! Retail BCPack chunks decoded by XCL against a reference decoder's blocks.
+//! Set `XCL_SAMPLE_BCPACK` to a directory of `<name>.bc<N>` + `<name>.vic<N>` files;
+//! without it the test does nothing.
+
+#[test]
+fn retail_chunks_match_the_reference() {
+    let Some(dir) = std::env::var_os("XCL_SAMPLE_BCPACK") else { return };
+    let dir = std::path::Path::new(&dir);
+    let entries = std::fs::read_dir(dir)
+        .unwrap_or_else(|e| panic!("XCL_SAMPLE_BCPACK {}: {e}", dir.display()));
+    let mut cases = 0;
+    let mut identical = 0;
+    let mut bad_bytes = 0u64;
+    let mut total_bytes = 0u64;
+    for entry in entries {
+        let path = entry.unwrap().path();
+        let Some(ext) = path.extension().and_then(|e| e.to_str()) else { continue };
+        let Some(mode) = ext.strip_prefix("bc").and_then(|m| m.parse::<u8>().ok()) else { continue };
+        let vic = path.with_extension(format!("vic{mode}"));
+        let src = std::fs::read(&path).unwrap();
+        let want = if vic.exists() {
+            std::fs::read(&vic).unwrap()
+        } else {
+            std::fs::read(path.with_extension("out")).unwrap()
+        };
+        let got = match xcl::hle::bcpack::decode(mode, &src, want.len()) {
+            Ok(got) => got,
+            Err(e) => {
+                println!("{}: mode {mode} failed: {e}", path.display());
+                cases += 1;
+                continue;
+            }
+        };
+        cases += 1;
+        total_bytes += want.len() as u64;
+        if got == want {
+            identical += 1;
+        } else {
+            let n = got.iter().zip(&want).filter(|(a, b)| a != b).count();
+            bad_bytes += n as u64;
+            println!("{}: mode {mode}, {n} of {} bytes differ", path.file_name().unwrap().to_string_lossy(), want.len());
+        }
+    }
+    println!(
+        "cases {cases}, byte-identical {identical}, differing bytes {bad_bytes} of {total_bytes} ({:.4}%)",
+        100.0 * bad_bytes as f64 / total_bytes.max(1) as f64
+    );
+    assert!(cases > 0);
+    assert_eq!(identical, cases, "every case must match the reference");
+}
diff --git a/scripts/gen_bcpack_victory_tables.py b/scripts/gen_bcpack_victory_tables.py
new file mode 100644
index 0000000000000000000000000000000000000000..83073c74624afde7476c3278820c581cdd458037
--- /dev/null
+++ b/scripts/gen_bcpack_victory_tables.py
@@ -0,0 +1,152 @@
+"""Turn VIctory's bcpack-tables.bin into Rust constants for XCL.
+
+bcpack-tables.bin is from the VIctory repo (github.com/Marvisak/VIctory),
+victory-formats/bcpack-tables.bin.
+
+Layout is that of the format's constant tables: 128 x 9 u16 model frequencies, the
+rank tables, 512 u16 BC7 control words, then 255 dictionary entries per format.
+BC7 entries follow VIctory PR #658: after the two index widths, two bytes repeat
+them and there are 16 + 15 signed indices, not 32.
+
+    python -I scripts/gen_bcpack_victory_tables.py <bcpack-tables.bin> <out.rs>
+"""
+import struct
+import sys
+
+MODELS, BUCKETS, DICTIONARY = 128, 9, 255
+
+
+class R:
+    def __init__(self, b):
+        self.b, self.i = b, 0
+
+    def take(self, n):
+        v = self.b[self.i:self.i + n]
+        self.i += n
+        return v
+
+    def u8(self):
+        return self.take(1)[0]
+
+    def u16(self):
+        return struct.unpack("<H", self.take(2))[0]
+
+    def i16(self):
+        return struct.unpack("<h", self.take(2))[0]
+
+
+def rows(vals, per, fmt):
+    out = []
+    for i in range(0, len(vals), per):
+        out.append("    " + ", ".join(fmt(v).rstrip(",") for v in vals[i:i + per]) + ",")
+    return "\n".join(out)
+
+
+def rows2(vals, per):
+    out = []
+    for i in range(0, len(vals), per):
+        out.append("    [%s]," % ", ".join("%du32" % v for v in vals[i:i + per]))
+    return "\n".join(out)
+
+
+def main(src, dst):
+    r = R(open(src, "rb").read())
+    freq = [r.u16() for _ in range(MODELS * BUCKETS)]
+    rank1 = list(r.take(256))
+    rank3a = list(r.take(64))
+    rank3c = list(r.take(256))
+    rank4 = list(r.take(64))
+    rank5 = list(r.take(64))
+    ctrl7 = [r.u16() for _ in range(512)]
+
+    def plain(ep, ix):
+        out = []
+        for _ in range(DICTIONARY):
+            out.append((list(r.take(ep)), [r.u8() for _ in range(ix)]))
+        return out
+
+    bc1, bc3, bc4, bc5 = plain(6, 16), plain(8, 32), plain(2, 16), plain(4, 32)
+    bc6 = []
+    for _ in range(DICTIONARY):
+        r.u8()
+        e = [r.u16() for _ in range(12)]
+        mode = r.u8()
+        ix = [r.i16() for _ in range(16)]
+        bc6.append((e, mode, ix))
+    bc7 = []
+    for _ in range(DICTIONARY):
+        ctrl = r.u16()
+        ep = [r.u16() for _ in range(24)]
+        bits = [r.u8(), r.u8()]
+        r.u16()  # the widths again; not indices
+        ix = [r.i16() for _ in range(31)] + [0]  # set 1 has 15 slots, unused
+        bc7.append((ctrl, ep, bits, ix))
+    assert r.i == len(r.b), (r.i, len(r.b))
+
+    def plain_entries(items):
+        out = []
+        for ep, ix in items:
+            e = ep + [0] * (8 - len(ep))
+            i = ix + [0] * (32 - len(ix))
+            out.append("    Plain { ep: [%s], ix: [%s] }," % (
+                ", ".join(map(str, e)), ", ".join(map(str, i))))
+        return "\n".join(out)
+
+    src_lines = [
+        "// Generated by scripts/gen_bcpack_victory_tables.py from VIctory's",
+        "// bcpack-tables.bin; the format's constant tables, not derived here.",
+        "",
+        "pub const MODELS: usize = %d;" % MODELS,
+        "pub const BUCKETS: usize = %d;" % BUCKETS,
+        "pub const DICTIONARY: usize = %d;" % DICTIONARY,
+        "",
+        "#[derive(Clone, Copy, Default)]",
+        "pub struct Plain { pub ep: [u8; 8], pub ix: [u8; 32] }",
+        "#[derive(Clone, Copy, Default)]",
+        "pub struct Bc6Ep { pub e: [[u16; 3]; 4] }",
+        "#[derive(Clone, Copy, Default)]",
+        "pub struct Bc6Ix { pub mode: u8, pub ix: [i16; 16] }",
+        "#[derive(Clone, Copy, Default)]",
+        "pub struct Bc7Ep { pub ctrl: u16, pub rows: [[u16; 8]; 3] }",
+        "#[derive(Clone, Copy, Default)]",
+        "pub struct Bc7Ix { pub bits: [u8; 2], pub ix: [[i16; 16]; 2] }",
+        "",
+        "pub static FREQ: [[u32; BUCKETS]; MODELS] = [",
+        rows2(freq, BUCKETS),
+        "];",
+        "pub static RANK1: [u8; 256] = [%s];" % ", ".join(map(str, rank1)),
+        "pub static RANK3A: [u8; 64] = [%s];" % ", ".join(map(str, rank3a)),
+        "pub static RANK3C: [u8; 256] = [%s];" % ", ".join(map(str, rank3c)),
+        "pub static RANK4: [u8; 64] = [%s];" % ", ".join(map(str, rank4)),
+        "pub static RANK5: [u8; 64] = [%s];" % ", ".join(map(str, rank5)),
+        "pub static CTRL7: [u16; 512] = [%s];" % ", ".join(map(str, ctrl7)),
+        "pub static BC1: [Plain; DICTIONARY] = [",
+        plain_entries(bc1), "];",
+        "pub static BC3: [Plain; DICTIONARY] = [",
+        plain_entries(bc3), "];",
+        "pub static BC4: [Plain; DICTIONARY] = [",
+        plain_entries(bc4), "];",
+        "pub static BC5: [Plain; DICTIONARY] = [",
+        plain_entries(bc5), "];",
+        "pub static BC6: [(Bc6Ep, Bc6Ix); DICTIONARY] = [",
+    ]
+    for e, mode, ix in bc6:
+        src_lines.append(
+            "    (Bc6Ep { e: [[%s], [%s], [%s], [%s]] }, Bc6Ix { mode: %d, ix: [%s] })," % (
+                ", ".join(map(str, e[0:3])), ", ".join(map(str, e[3:6])),
+                ", ".join(map(str, e[6:9])), ", ".join(map(str, e[9:12])),
+                mode, ", ".join(map(str, ix))))
+    src_lines += ["];", "pub static BC7: [(Bc7Ep, Bc7Ix); DICTIONARY] = ["]
+    for ctrl, ep, bits, ix in bc7:
+        rows_3 = ", ".join("[%s]" % ", ".join(map(str, ep[k:k + 8])) for k in range(0, 24, 8))
+        src_lines.append(
+            "    (Bc7Ep { ctrl: %d, rows: [%s] }, Bc7Ix { bits: [%d, %d], ix: [[%s], [%s]] })," % (
+                ctrl, rows_3, bits[0], bits[1],
+                ", ".join(map(str, ix[:16])), ", ".join(map(str, ix[16:]))))
+    src_lines += ["];", ""]
+    open(dst, "w", encoding="utf-8", newline="\n").write("\n".join(src_lines))
+    print("wrote", dst, "entries", len(bc1), len(bc3), len(bc4), len(bc5), len(bc6), len(bc7))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
