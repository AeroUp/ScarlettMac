+            stride: 16,
+            size: (SIZE, SIZE),
+            mesh_groups: 0,
+        };
+        let isg1 = container::signature(&[], true);
+        let osg1 = rows(&[("SV_Target", 16, false)], false);
+        let words = [0x0804_00F2, 0x0804_0302, 0x7E06_02F2, 0xF800_180F, 0x0301_0002, 0xBF81_0000];
+        let options = super::Options { direct_barycentrics: true, ..Default::default() };
+        let sub = |a: [f32; 2], b: [f32; 2]| [a[0] - b[0], a[1] - b[1]];
+        let cross = |a: [f32; 2], b: [f32; 2]| a[0] * b[1] - a[1] * b[0];
+        let (e1, e2) = (sub(ndc[1], ndc[0]), sub(ndc[2], ndc[0]));
+        let area = cross(e1, e2);
+
+        for (mode, input, perspective) in [("screen-linear", 1 << 5, false), ("perspective", 1 << 1, true)] {
+            let ps = emit_pixel_with_options(&words, vec![], input, &isg1, &osg1, options)
+                .expect("translate the barycentric pixel shader");
+            let vs = HostShader { dxil: vertex_dxil.clone(), ..super::host::stub_vs(&ps).unwrap() };
+            let (root, pso) = host.pipeline(&vs, &ps).unwrap_or_else(|e| panic!("{mode} PSO: {e}"));
+            let pixels = host.draw(&root, &pso, &draw).unwrap_or_else(|e| panic!("{mode} draw: {e}"));
+            let mut checked = 0;
+            for y in 0..SIZE {
+                for x in 0..SIZE {
+                    let scale = 2.0 / SIZE as f32;
+                    let p = [(x as f32 + 0.5) * scale - 1.0, 1.0 - (y as f32 + 0.5) * scale];
+                    let d = sub(p, ndc[0]);
+                    let (i, j) = (cross(d, e2) / area, cross(e1, d) / area);
+                    let linear = [1.0 - i - j, i, j];
+                    if linear.iter().any(|&value| value < 0.02) {
+                        continue;
+                    }
+                    let q = [linear[0] / w[0], linear[1] / w[1], linear[2] / w[2]];
+                    let expected = if perspective {
+                        let sum: f32 = q.iter().sum();
+                        q.map(|weight| weight / sum)
+                    } else {
+                        linear
+                    };
+                    let actual = pixels[(y * SIZE + x) as usize];
+                    assert!(
+                        actual[..3].iter().zip(expected).all(|(&a, e)| (a - e).abs() < 2e-3)
+                            && actual[3] == 1.0,
+                        "{mode} ({x},{y}): actual {actual:?}, expected {expected:?}",
+                    );
+                    checked += 1;
+                }
+            }
+            assert!(checked > 100);
+            println!("{mode} native PSO and fence readback match at {checked} interior pixels");
+        }
+    }
