diff --git a/crates/victory-gpu/src/snapshot_pool.rs b/crates/victory-gpu/src/snapshot_pool.rs
new file mode 100644
index 0000000..f0b59ce
--- /dev/null
+++ b/crates/victory-gpu/src/snapshot_pool.rs
@@ -0,0 +1,100 @@
+const MIB: usize = 1 << 20;
+const DEFAULT_MIB: usize = 2048;
+
+pub(crate) fn limit_bytes(value: Option<&str>) -> usize {
+    value
+        .and_then(|value| value.parse::<usize>().ok())
+        .filter(|&mib| mib <= DEFAULT_MIB)
+        .unwrap_or(DEFAULT_MIB)
+        * MIB
+}
+
+pub(crate) struct SnapshotPool {
+    buffers: Vec<Vec<u8>>,
+}
+
+impl SnapshotPool {
+    pub(crate) const fn new() -> Self {
+        Self {
+            buffers: Vec::new(),
+        }
+    }
+
+    pub(crate) fn take(&mut self, size: usize) -> Vec<u8> {
+        let index = self
+            .buffers
+            .iter()
+            .enumerate()
+            .filter(|(_, bytes)| bytes.capacity() >= size)
+            .min_by_key(|(_, bytes)| bytes.capacity())
+            .map(|(index, _)| index);
+        let mut bytes =
+            index.map_or_else(|| Vec::with_capacity(size), |i| self.buffers.swap_remove(i));
+        bytes.clear();
+        bytes
+    }
+
+    pub(crate) fn recycle(&mut self, bytes: Vec<u8>, limit: usize) {
+        if limit < DEFAULT_MIB * MIB && (limit == 0 || bytes.capacity() > limit) {
+            return;
+        }
+        self.buffers.push(bytes);
+        self.buffers
+            .sort_by_key(|bytes| std::cmp::Reverse(bytes.capacity()));
+        let mut retained = 0usize;
+        let keep = self
+            .buffers
+            .iter()
+            .take_while(|bytes| {
+                retained = retained.saturating_add(bytes.capacity());
+                retained <= limit
+            })
+            .count();
+        self.buffers.truncate(keep);
+    }
+
+    #[cfg(any(feature = "diagnostics", test))]
+    pub(crate) fn retained_bytes(&self) -> usize {
+        self.buffers.iter().map(Vec::capacity).sum()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_mib_or_retains_the_default() {
+        assert_eq!(limit_bytes(None), 2048 * MIB);
+        assert_eq!(limit_bytes(Some("256")), 256 * MIB);
+        assert_eq!(limit_bytes(Some("0")), 0);
+        assert_eq!(limit_bytes(Some("2049")), 2048 * MIB);
+        assert_eq!(limit_bytes(Some("-1")), 2048 * MIB);
+    }
+
+    #[test]
+    fn caps_free_buffers_and_allows_larger_active_snapshots() {
+        let mut pool = SnapshotPool::new();
+        let small = Vec::with_capacity(32);
+        let large = Vec::with_capacity(64);
+        let (small_capacity, large_capacity) = (small.capacity(), large.capacity());
+        let limit = small_capacity + large_capacity;
+        pool.recycle(small, limit);
+        pool.recycle(large, limit);
+
+        let active = pool.take(limit + 1);
+        assert!(active.capacity() > limit);
+        pool.recycle(active, limit);
+        assert_eq!(pool.retained_bytes(), limit);
+
+        let reused = pool.take(small_capacity);
+        assert!(reused.is_empty());
+        assert_eq!(reused.capacity(), small_capacity);
+        pool.recycle(Vec::with_capacity(large_capacity), limit);
+        assert_eq!(pool.retained_bytes(), large_capacity);
+
+        let mut disabled = SnapshotPool::new();
+        disabled.recycle(reused, 0);
+        assert_eq!(disabled.retained_bytes(), 0);
+    }
+}
