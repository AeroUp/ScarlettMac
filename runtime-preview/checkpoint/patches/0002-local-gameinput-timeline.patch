+#[cfg(feature = "diagnostics")]
+fn trace_stick_read(reading: &Reading, state: &PadState) {
+    static ENABLED: LazyLock<bool> = LazyLock::new(|| {
+        std::env::var_os("VICTORY_TRACE_RETURNED_STICKS").is_some_and(|value| value == "1")
+    });
+    if !*ENABLED {
+        return;
+    }
+    // SAFETY: the device belongs to the reading's permanently allocated hub.
+    let device = unsafe { &*reading.device };
+    let axes = [state.left_x, state.left_y, state.right_x, state.right_y];
+    let zones = axes.map(|value| i8::from(value >= 0.5) - i8::from(value <= -0.5));
+    let mut last = lock(&device.last_stick_read);
+    if last.is_some_and(|(sequence, _)| reading.sequence <= sequence) {
+        return;
+    }
+    let old = last.replace((reading.sequence, zones));
+    if old.is_some_and(|(_, previous)| previous == zones) {
+        return;
+    }
+    let present_serial = victory_gpu::queue::diagnostic_present_serial();
+    drop(last);
+    tracing::info!(
+        device = device.index,
+        sequence = reading.sequence,
+        present_serial,
+        left = ?[state.left_x, state.left_y],
+        right = ?[state.right_x, state.right_y],
+        "title read stick state",
+    );
+}
