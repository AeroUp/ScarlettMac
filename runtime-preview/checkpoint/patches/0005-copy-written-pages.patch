+static FORCED: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
+/// Turns tracking on (or off) for the rest of the run, as
+/// `VICTORY_FAULT_TRACKING` would: the runtime calls it when the loader will
+/// patch every store of the title that Rosetta cannot resume after a fault.
+/// An explicit `VICTORY_FAULT_TRACKING` still wins (the runtime asks only
+/// when it is unset), and this is not meant to be called after memory has
+/// been tracked: the runtime calls it before loading the title.
+pub fn set_fault_tracking(on: bool) {
+    FORCED.store(if on { 2 } else { 1 }, Ordering::Release);
+}
